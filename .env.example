# انسخ الملف ده باسم .env لو هتشغل محلي - وممنوع تعمل commit لملف .env الحقيقي.
# دول بس المتغيرات المطلوبة في Railway (Variables) - أي إعداد تاني (استراتيجية/مخاطرة/أزواج)
# اتحكم فيه لايف من بوت تليجرام، مش من هنا. اكتب /help في تليجرام بعد التشغيل.

# ---- MEXC API (سرية جداً) ----
# من إعدادات API في MEXC (صلاحية Spot Trade فقط، من غير Withdraw)
MEXC_API_KEY=
MEXC_API_SECRET=

# ---- بوت تليجرام للتحكم الكامل ----
# احصل عليه من @BotFather على تليجرام
TELEGRAM_BOT_TOKEN=
# آيديك على تليجرام (احصل عليه من @userinfobot) - افصل بفاصلة لو أكتر من شخص مصرح له
TELEGRAM_CHAT_ID=
# اختياري: آيديات إضافية مصرح لها بالتحكم (بيتضاف لـ TELEGRAM_CHAT_ID مش بيلغيها)
TELEGRAM_ADMIN_IDS=

# ---- وضع التشغيل الافتراضي وقت أول إقلاع للبوت ----
# true = يبدأ في وضع تجربة آمن (مفيش تنفيذ حقيقي). غيّرها لايف بعد كده من تليجرام
# بـ /dryrun_on أو /dryrun_off - المتغير ده بس بيحدد الوضع الابتدائي.
DRY_RUN=true

# ---- قاعدة البيانات - Railway بيحطها تلقائي عند إضافة Postgres plugin ----
DATABASE_URL=

# ---- مراقبة قنوات التوصيات (اختياري - سيب فاضي لو مش عايز الميزة دي) ----
# TELEGRAM_API_ID و TELEGRAM_API_HASH: احصل عليهم من https://my.telegram.org (API development tools)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# TELEGRAM_SESSION_STRING: بتتولد مرة واحدة بس محلياً على جهازك بسكريبت generate_session.py
# (مينفعش تسجيل دخول تفاعلي على Railway - سيرفر بدون واجهة)
TELEGRAM_SESSION_STRING=
# أسماء يوزر القنوات (من غير @) أو آيديات القنوات - مفصولة بفاصلة
# مثال: SIGNAL_CHANNELS=some_signals_channel,-1001234567890
SIGNAL_CHANNELS=
